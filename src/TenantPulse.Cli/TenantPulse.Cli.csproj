<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>tenant-pulse</AssemblyName>
    <RootNamespace>TenantPulse.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TenantPulse.Core\TenantPulse.Core.csproj" />
    <ProjectReference Include="..\TenantPulse.Engine\TenantPulse.Engine.csproj" />
  </ItemGroup>

  <!--
    The admin web is hosted inside the run process because the simulator is single-writer: a
    separate service that could trigger activity would double-post into the tenant and race the
    journal. A framework reference keeps this a console app that can also serve HTTP.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Embedded so the published container is one artefact and the page cannot go missing. -->
  <ItemGroup>
    <EmbeddedResource Include="Admin\index.html" />
  </ItemGroup>

  <!--
    No Microsoft.Extensions.* package references: the ASP.NET Core shared framework already
    supplies configuration, DI and logging, and NuGet fails the build (NU1510) if they are also
    listed here. Add them back only if the framework reference above ever goes away.
  -->

</Project>
